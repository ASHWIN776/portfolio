---
import "../styles/global.css"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { ClientRouter } from "astro:transitions"

const { pageTitle, wideLayout = false } = Astro.props
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{`Ashwin's ${pageTitle}`}</title>
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title="Ashwin's Blog" href={new URL("rss.xml", Astro.site)} />
		<script is:inline>
			if (localStorage.getItem('theme') !== 'light') {
				document.documentElement.classList.add('dark');
			}
		</script>
		<script is:inline>
			document.addEventListener('astro:before-swap', (e) => {
				const dark = document.documentElement.classList.contains('dark');
				e.newDocument.documentElement.classList.toggle('dark', dark);
			});
		</script>
		<ClientRouter />
	</head>
	<body>
		<div class="p-4 min-h-dvh flex flex-col gap-y-10 justify-between">
			<div class="md:max-w-[640px] md:mx-auto w-full">
				<Header pageTitle={pageTitle}/>
			</div>
			<main class={`${wideLayout ? 'md:max-w-7xl' : 'md:max-w-[640px]'} md:mx-auto w-full flex flex-col grow`}>
				<slot />
			</main>
			<div class="md:max-w-[640px] md:mx-auto w-full">
				<Footer />
			</div>
		</div>
	</body>
</html>
