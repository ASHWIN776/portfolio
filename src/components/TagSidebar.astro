---
import { tagToSlug } from "../utils/tags";

interface Props {
  tags: string[];
  activeTag: string | null;
}

const { tags, activeTag } = Astro.props;
---

<aside class="hidden lg:block">
  <nav class="sticky top-4">
    <h2 class="text-sm font-bold mb-4 text-muted">Filter by Tag</h2>
    <ul class="flex flex-col gap-y-2 text-sm">
      <li>
        <a
          href="/blog"
          class={activeTag === null
            ? "text-secondary"
            : "text-subtle hover:text-secondary transition-colors duration-200"}
        >
          All
        </a>
      </li>
      {tags.map((tag) => (
        <li>
          <a
            href={`/blog/tags/${tagToSlug(tag)}`}
            class={activeTag === tag
              ? "text-secondary"
              : "text-subtle hover:text-secondary transition-colors duration-200"}
          >
            {tag}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>
