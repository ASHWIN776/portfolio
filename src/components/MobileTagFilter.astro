---
import { tagToSlug } from "../utils/tags";

interface Props {
  tags: string[];
  activeTag: string | null;
}

const { tags, activeTag } = Astro.props;
---

<div class="lg:hidden flex flex-wrap gap-2">
  <a
    href="/blog"
    class={activeTag === null
      ? "bg-tag-bg text-tag-text px-3 py-1 rounded-md font-bold text-xs"
      : "border border-divider-soft text-subtle px-3 py-1 rounded-md text-xs transition-colors duration-200"}
  >
    All
  </a>
  {tags.map((tag) => (
    <a
      href={`/blog/tags/${tagToSlug(tag)}`}
      class={activeTag === tag
        ? "bg-tag-bg text-tag-text px-3 py-1 rounded-md font-bold text-xs"
        : "border border-divider-soft text-subtle px-3 py-1 rounded-md text-xs transition-colors duration-200"}
    >
      {tag}
    </a>
  ))}
</div>