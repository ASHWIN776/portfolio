---
import BaseLayout from "../layouts/BaseLayout.astro"
import SectionLayout from "../layouts/SectionLayout.astro"
import ProjectCard from "../components/ProjectCard.astro"
import { getCollection } from "astro:content"

const pageTitle = "Projects"
const projects = (await getCollection("projects")).reverse()
---

<BaseLayout pageTitle={pageTitle} wideLayout={true}>
  <div class="grid grid-cols-1 lg:grid-cols-[250px_1fr_250px] gap-8 grow">
    <aside class="hidden lg:block">
      <nav class="sticky top-4">
        <h2 class="text-sm font-bold mb-4 text-muted">Table of Contents</h2>
        {projects.length > 0 ? (
          <ol class="flex flex-col gap-y-2 text-sm" id="toc-list">
            {projects.map((project, index) => (
              <li>
                <a
                  href={`#${project.data.name}`}
                  data-heading-id={project.data.name}
                  class="toc-link text-subtle hover:text-secondary transition-colors duration-200"
                >
                  {index + 1}. {project.data.name}
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="text-faint text-xs">No headings found</p>
        )}
      </nav>
    </aside>

    <div class="flex flex-col gap-y-8 max-w-[640px] mx-auto w-full">
      <SectionLayout title="Projects">
        {
          projects.map(project => (
            <ProjectCard project={project.data} />
          ))
        }
      </SectionLayout>
    </div>

    <div class="hidden lg:block"></div>
  </div>

  <script>
    function initTocHighlight() {
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>('#toc-list a[data-heading-id]');
      if (!tocLinks.length) return;

      const headingIds = Array.from(tocLinks).map(link => link.dataset.headingId!);
      const headingElements = headingIds
        .map(id => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);

      if (!headingElements.length) return;

      let activeId: string | null = null;
      const visibleIds = new Set<string>();

      function updateActive() {
        const topmost = headingElements.find(el => visibleIds.has(el.id));
        const id = topmost?.id ?? null;
        if (!id || id === activeId) return;
        activeId = id;
        tocLinks.forEach(link => {
          if (link.dataset.headingId === id) {
            link.classList.remove('text-subtle');
            link.classList.add('text-secondary', 'font-medium');
          } else {
            link.classList.remove('text-secondary', 'font-medium');
            link.classList.add('text-subtle');
          }
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              visibleIds.add(e.target.id);
            } else {
              visibleIds.delete(e.target.id);
            }
          });
          updateActive();
        },
        { rootMargin: '0px 0px -70% 0px', threshold: 0 }
      );

      headingElements.forEach(el => observer.observe(el));
    }

    initTocHighlight();
    document.addEventListener('astro:after-swap', initTocHighlight);
  </script>
</BaseLayout>